#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/soc/eswin-pmp.h>
#include "eic7702-s560.dtsi"
#include "dt-bindings/media/eswin_mipi_dsi.h"
#include "media_bus_format.h"
/ {
	#address-cells = <2>;
	#size-cells = <2>;
	model = "ESWIN EBC7702-P01 D560";


	aliases {
		serial0 = &uart0;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		i2c9 = &i2c9;
		i2c11 = &i2c11;
		i2c12 = &i2c12;
		gpio0 = &gpio0;
		spi0 = &bootspi;
		spi1 = &dw_spi0;
		spi2 = &d1_bootspi;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio6_default &pinctrl_gpio107_default &pinctrl_gpio108_default &pinctrl_gpio109_default>;

		gpio-107 {
			gpios = <&portd 11 GPIO_ACTIVE_HIGH>;
			label = "power";
			linux,default-trigger = "default-on";
		};

		gpio-108 {
			gpios = <&portd 12 GPIO_ACTIVE_HIGH>;
			label = "heartbeat";
			linux,default-trigger = "heartbeat";
		};

		gpio-109 {
			gpios = <&portd 13 GPIO_ACTIVE_HIGH>;
			label = "gpio-109";
			linux,default-trigger = "default-off";
		};

		gpio-110 {
			gpios = <&portd 14 GPIO_ACTIVE_HIGH>;
			label = "gpio-109";
			linux,default-trigger = "default-off";
		};
	};

};

&dw_spi0 {
	status = "okay";
	spi-flash@1 {
		reg = <1>;
		compatible = "winbond,w25q128fw",
			"jedec,spi-nor";
		spi-max-frequency = <4800000>;
	};
};

&eth0 {
	status = "okay";
	phy-mode = "rgmii-txid";
	max-speed = <1000>;
	phy-handle = <&phy0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio94_default>;
	rst-gpios = <&portc 30 GPIO_ACTIVE_LOW>;
	dly-param-1000m = <0x23232323 0x5a0c6423 0x0c0c0c0c>;
	dly-param-100m = <0x50505050 0x803f8050 0x3f3f3f3f>;
	dly-param-10m = <0 0 0>;
	mdio0 {
		#address-cells = <1>;
		#size-cells = <0>;
		phy0: ethernet-phy@1 {
			reg = <0>;
		};
	};
};

&eth1 {
	status = "disabled";
	phy-mode = "rgmii-txid";
	max-speed = <1000>;
	phy-handle = <&phy1>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio16_default>;
	rst-gpios = <&porta 16 GPIO_ACTIVE_LOW>;
	dly-param-1000m = <0x25252525 0x5a266425 0x26262626>;
	dly-param-100m = <0x48484848 0x80588048 0x58585858>;
	dly-param-10m = <0 0 0>;
	mdio1 {
		#address-cells = <1>;
		#size-cells = <0>;
		phy1: ethernet-phy@1 {
			reg = <0>;
		};
	};
};

&eswin_sata {
	status = "okay";
};

&pcie {
	status = "disabled";
};
&display_logo {
	status = "disabled";
};
&mipi_dsi {
	status = "disabled";
	panel {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "simple-panel-dsi";
		reg = <0>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		bus-format = <MEDIA_BUS_FMT_RGB888_1X24>;
		dsi,lanes = <4>;
		status = "disabled";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio7_default &pinctrl_gpio111_default>;
		backlight-gpios = <&porta 7 GPIO_ACTIVE_LOW>;
		rst-gpios = <&portd 15 GPIO_ACTIVE_LOW>;
		display-timings {
			native-mode = <&timing0>;
			timing0: timing0 {
				/*The fpga platform does not need to set the clock*/
				clock-frequency = <148500000>;
				hactive = <1080>;
				vactive = <1920>;
				hsync-len = <60>;
				hback-porch = <60>;
				hfront-porch = <60>;
				vsync-len = <8>;
				vback-porch = <8>;
				vfront-porch = <8>;
				hsync-active = <0>;
				vsync-active = <0>;
				pixelclk-active = <1>;
			};
		};
	};
};
&d1_mipi_dsi {
	status = "disabled";
};

&hdmi {
	status = "disabled";
};
&d1_hdmi {
	status = "disabled";
};
&display_subsystem {
	status = "disabled";
};
&d1_display_subsystem {
	double-screen = <1>;
	status = "disabled";
};
&route_hdmi {
	status = "disabled";
};
&d1_route_hdmi {
	status = "disabled";
};
&route_mipi {
	status = "disabled";
};
&d1_route_mipi {
	status = "disabled";
};
&osd {
	status = "disabled";
};
&d1_osd {
	status = "disabled";
};
