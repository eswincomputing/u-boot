#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/soc/eswin-pmp.h>
#include "eic770x.dtsi"
#include "dt-bindings/media/eswin_mipi_dsi.h"
#include "media_bus_format.h"
/ {
	#address-cells = <2>;
	#size-cells = <2>;
	model = "ESWIN EIC7702 S560";

	chosen {
		stdout-path = "serial0";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x4 0x00000000>;
		numa-node-id = <0>;
	};

	memory@2000000000 {
		device_type = "memory";
		reg = <0x20 0x00000000 0x4 0x00000000>;
		numa-node-id = <1>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		display_reserved: region@E0000000 {
			reg = <0x0 0xE0000000 0x0 0x2000000>;
			no-map;
		};

		lpcpu_reserved: lpcpures@DFFE0000 {
			reg = <0x00 0xDFFE0000 0x00 0x00020000>;
			no-map;
		};

		d1_display_reserved: region@20e0000000 {
			reg = <0x20 0xE0000000 0x0 0x2000000>;
			no-map;
		};
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "SiFive,FU800-soc", "fu800-soc", "sifive-soc", "simple-bus";
		ranges;

		pwm0: pwm@50818000 {
			compatible = "eswin,pwm-eswin";
			#pwm-cells = <3>;
			reg = <0x0 0x50818000 0x0 0x4000>;
			clock-names = "pclk";
			clocks = <&spiclk>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_pwm0_default>;
			status = "okay";
		};
	};
};
&cpu0 {
	status = "okay";
};
&cpu1 {
	status = "okay";
};
&cpu2 {
	status = "okay";
};
&cpu3 {
	status = "okay";
};
&cpu4 {
	status = "okay";
};
&cpu5 {
	status = "okay";
};
&cpu6 {
	status = "okay";
};
&cpu7 {
	status = "okay";
};
&plic0{
	status = "okay";
};
&d0_mbox {
	status = "okay";
};
&d0_mbox_srvc {
	status = "okay";
};
&d0_mbox1 {
	status = "okay";
};
&d0_mbox_srvc1 {
	status = "okay";
};
&d1_mbox1 {
	status = "okay";
};
&d1_mbox_srvc1 {
	status = "okay";
};
&d0_pmp {
	status = "okay";
};
&uart0 {
	status = "okay";
};
&uart1 {
	status = "okay";
};
&cru {
	status = "okay";
};
&rst {
	status = "okay";
};
&d1_cru {
	status = "okay";
};
&d1_rst {
	status = "okay";
};
&bootspi {
	status = "okay";
	cs-gpios = <&portd 0 GPIO_ACTIVE_LOW>;
	wp-gpios = <&portd 4 GPIO_ACTIVE_LOW>;
	spi-flash@0 {
		reg = <0>;
		compatible = "winbond,w25q128fw",
			"jedec,spi-nor";
		spi-max-frequency = <4800000>;
	};
};

&d1_bootspi{
	status = "okay";
	cs-gpios = <&d1_portd 0 GPIO_ACTIVE_LOW>;
	wp-gpios = <&d1_portd 4 GPIO_ACTIVE_LOW>;
	spi-flash@0 {
		reg = <0>;
		compatible = "winbond,w25q128fw",
			"jedec,spi-nor";
		spi-max-frequency = <4800000>;
	};
};

&sdhci_emmc {
	status = "okay";
	delay_code = <0x50>;
	drive-impedance-ohm = <33>;
	enable-cmd-pullup;
	enable-data-pullup;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
};

&sd {
	status = "okay";
	delay_code = <0x55>;
	drive-impedance-ohm = <33>;
	enable-cmd-pullup;
	enable-data-pullup;
};

&d1_sdhci_emmc {
	status = "disabled";
	delay_code = <0x55>;
	drive-impedance-ohm = <50>;
	enable-cmd-pullup;
	enable-data-pullup;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
};

&d1_sdio0 {
        status = "okay";
        delay_code = <0x29>;
        drive-impedance-ohm = <33>;
        enable-cmd-pullup;
        enable-data-pullup;
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_die1_gpio13_default>;
        rst-gpios = <&d1_porta 13 GPIO_ACTIVE_HIGH>;
};


&dwc3_typec0 {
		status = "okay";
		dr_mode = "peripheral";
		maximum-speed = "super-speed";
};

&usb0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio42_default>;
	pwren-gpios = <&portb 10 GPIO_ACTIVE_HIGH>;
};

&usb1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio14_default>;
	hub-rst-gpios = <&porta 14 GPIO_ACTIVE_HIGH>;
};

&d1_usb0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_die1_gpio42_default>;
	pwren-gpios = <&d1_portb 10 GPIO_ACTIVE_HIGH>;
};

&d1_usb1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_die1_gpio43_default>;
	pwren-gpios = <&d1_portb 11 GPIO_ACTIVE_HIGH>;
};

&i2c0 {
	status = "disabled";
};
&i2c2 {
	status = "disabled";
};
&i2c3 {
	status = "disabled";
};
&i2c11 {
	status = "okay";
};

/*
	gpio function unused
	group A: gpio1~6,12~15, 17~27, 29~31
	group B: gpio32~63
	group C: gpio64~93, 95
	group D: gpio96~105

	gpio0   : head phone plug/unplug detection0(I)
	gpio7   : led back light power on/off(O)
	gpio8   : dsi touch interrupt(I)
	gpio9   : pcie present(I)
	gpio10  : software define key input(I)
	gpio11  : head phone plug/unplug detection2(I)
	gpio16  : gphy1 resern(O)
	gpio28  : head phone plug/unplug detection1(I)
	gpio94  : gphy0 resern(O)
	gpio106 : pcie socket power on/off(O)
	gpio107 : tf card power on/off(O)
	gpio108 : system led0(O)
	gpio109 : system led1(O)
	gpio110 : system led2(O)
	gpio111 : mipi dsi resetn(O)
*/

&gpio0 {
	status = "okay";
};

&d1_gpio {
	status = "okay";
};

&pinctrl {
	status = "okay";
	pinctrl_pwm0_default: pwm0-default {
		mux {
			groups = "pwm0_group";
			function = "pwm0_func";
		};
		conf {
			groups = "pwm0_group";
			input-enable = <0>;
			bias-pull-down = <1>;
			drive-strength = <2>;
		};
    };
};

&d1_pinctrl {
	status = "okay";
};
